NODE_ENV=development
PORT=4000

# Primary MongoDB connection string
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/ogcrm?appName=ogcrm
# Optional fallback URI if primary is unreachable (e.g. Atlas IP whitelist restriction during development)
MONGODB_FALLBACK_URI=mongodb://127.0.0.1:27017/ogcrm
MONGODB_MAX_POOL_SIZE=50
MONGODB_MIN_POOL_SIZE=10

# Redis Cache & Stream Buffer (ADAPTABLE)
# If REDIS_URL is omitted, empty, or set to 'disabled', the CRM runs in DIRECT_DATABASE mode.
# If connection fails, the CRM automatically degrades to DIRECT_DATABASE mode with zero downtime.
REDIS_URL=redis://127.0.0.1:6379
USE_REDIS=true
REQUIRE_REDIS=false
REDIS_CONNECT_TIMEOUT_MS=3000

# JWT Secrets for Authentication
JWT_SECRET=ogmedia_super_secret_crm_jwt_production_key_2026
JWT_REFRESH_SECRET=ogmedia_super_secret_crm_refresh_key_2026

# Allowed Frontend URLs for CORS (comma-separated, trailing slashes automatically normalized)
FRONTEND_URL=http://localhost:5173,http://127.0.0.1:5173,https://ogmedia-theta.vercel.app,https://ogmedia-6uxn.onrender.com

# Queue & Lead Ingestion Settings
LEAD_WORKER_CONCURRENCY=20
QUEUE_MAX_RETRIES=5
LEAD_DUPLICATE_WINDOW_SECONDS=300

# Worker & Diagnostics
START_IN_PROCESS_WORKER=true
SKIP_RATE_LIMIT=false
LOG_LEVEL=info
